<?xml version="1.0"?>
<robot name="z1">

  <!-- Planning groups -->
  <group name="arm">
    <chain base_link="link00" tip_link="link06"/>
  </group>

  <group name="gripper">
    <link name="gripperStator"/>
    <link name="gripperMover"/>
    <joint name="jointGripper"/>
  </group>

  <group name="arm_with_gripper">
    <chain base_link="link00" tip_link="gripperMover"/>
  </group>

  <!-- End effector: the gripper group is attached to link06 -->
  <end_effector name="z1_gripper" parent_link="link06" group="gripper" parent_group="arm"/>

  <!--
    Named states. All of them come from Unitree, not from this workspace:

      zero       = mechanical zero position (all joints 0), Z1 user manual
                   section 3.1 ("the lines on both sides of the J1 and J6
                   joint gaps correspond exactly").
      home       = official start pose: "home" in Unitree's own
                   z1_ros/z1_moveit_config/config/z1_description.srdf, and
                   "startFlat" in z1_controller/config/savedArmStates.csv
                   (the pose backToStart() drives to).
      forward    = "forward" in savedArmStates.csv; q_FORWARD in
                   z1_sdk/examples_py/example_model.py. This is the parking
                   pose of z1_controllers (initial_position): of the official
                   poses it is the one that lies fully inside the limits
                   (smallest margin 0.98 rad, at joint4).
      stow       = "stow" in the official SRDF (also the spawn pose of the
                   official gazebo.launch and the initial pose of the official
                   fake_controllers.yaml).
      pounce     = "pounce" in the official SRDF.
      show_left/ = "show_*" in savedArmStates.csv.
      show_mid/
      show_right
      open/closed= gripper only (local names; official gripper range is
                   [-90, 0] deg with 0 = closed).

    Every official joint-space pose keeps joint5 = joint6 = 0; the wrist
    singularity (joint4 axis || joint6 axis) is at joint5 = +-90 deg, outside
    the +-77 deg limit, so 0 is the neutral value.

    Two official caveats, both verified against this URDF:
      * home puts joint2 = 0 exactly on joint2's lower limit. That is the pose
        the manual asks for at power-on, but MoveIt only accepts start states
        strictly inside the limits (gravity sag pushes it out by ~1e-14 rad),
        which is why the controller parks at `forward` instead.
      * stow puts joint4 at 1.5707 rad = 90 deg, i.e. 0.052 rad (3 deg)
        *outside* the +-87 deg (1.51844 rad) joint4 limit of the official URDF.
        MoveIt therefore refuses it as a start state:
          "Joint 'joint4' from the starting state is outside bounds by:
           [1.5707 ] should be in the range [-1.51844 ], [1.51844 ]."
        The value is kept verbatim for reference; plan from/to `forward`.
  -->
  <group_state name="zero" group="arm">
    <joint name="joint1" value="0"/>
    <joint name="joint2" value="0"/>
    <joint name="joint3" value="0"/>
    <joint name="joint4" value="0"/>
    <joint name="joint5" value="0"/>
    <joint name="joint6" value="0"/>
  </group_state>
  <group_state name="home" group="arm">
    <joint name="joint1" value="0"/>
    <joint name="joint2" value="0"/>
    <joint name="joint3" value="-0.005"/>
    <joint name="joint4" value="-0.074"/>
    <joint name="joint5" value="0"/>
    <joint name="joint6" value="0"/>
  </group_state>
  <group_state name="forward" group="arm">
    <joint name="joint1" value="0"/>
    <joint name="joint2" value="1.5"/>
    <joint name="joint3" value="-1.0"/>
    <joint name="joint4" value="-0.54"/>
    <joint name="joint5" value="0"/>
    <joint name="joint6" value="0"/>
  </group_state>
  <group_state name="stow" group="arm">
    <joint name="joint1" value="0"/>
    <joint name="joint2" value="1.1"/>
    <joint name="joint3" value="-1.1"/>
    <joint name="joint4" value="1.5707"/>
    <joint name="joint5" value="0"/>
    <joint name="joint6" value="0"/>
  </group_state>
  <group_state name="pounce" group="arm">
    <joint name="joint1" value="0"/>
    <joint name="joint2" value="1.57"/>
    <joint name="joint3" value="-0.707"/>
    <joint name="joint4" value="-0.9"/>
    <joint name="joint5" value="0"/>
    <joint name="joint6" value="0"/>
  </group_state>
  <group_state name="show_left" group="arm">
    <joint name="joint1" value="-1.0"/>
    <joint name="joint2" value="0.9"/>
    <joint name="joint3" value="-1.0"/>
    <joint name="joint4" value="-0.3"/>
    <joint name="joint5" value="0"/>
    <joint name="joint6" value="0"/>
  </group_state>
  <group_state name="show_mid" group="arm">
    <joint name="joint1" value="0"/>
    <joint name="joint2" value="0.9"/>
    <joint name="joint3" value="-1.2"/>
    <joint name="joint4" value="0.25"/>
    <joint name="joint5" value="0"/>
    <joint name="joint6" value="0"/>
  </group_state>
  <group_state name="show_right" group="arm">
    <joint name="joint1" value="1.0"/>
    <joint name="joint2" value="0.9"/>
    <joint name="joint3" value="-1.0"/>
    <joint name="joint4" value="-0.3"/>
    <joint name="joint5" value="0"/>
    <joint name="joint6" value="0"/>
  </group_state>
  <group_state name="open" group="gripper">
    <joint name="jointGripper" value="-1.5"/>
  </group_state>
  <group_state name="closed" group="gripper">
    <joint name="jointGripper" value="0"/>
  </group_state>

  <!--
    Collision matrix.
    Adjacent pairs must be disabled (their collision geometry always touches);
    the "Never" entries are pairs that cannot touch within the joint limits.
  -->
  <disable_collisions link1="link00" link2="link01" reason="Adjacent"/>
  <disable_collisions link1="link01" link2="link02" reason="Adjacent"/>
  <disable_collisions link1="link02" link2="link03" reason="Adjacent"/>
  <disable_collisions link1="link03" link2="link04" reason="Adjacent"/>
  <disable_collisions link1="link04" link2="link05" reason="Adjacent"/>
  <disable_collisions link1="link05" link2="link06" reason="Adjacent"/>
  <disable_collisions link1="link06" link2="gripperStator" reason="Adjacent"/>
  <disable_collisions link1="gripperStator" link2="gripperMover" reason="Adjacent"/>

  <disable_collisions link1="link00" link2="link02" reason="Never"/>
  <disable_collisions link1="link01" link2="link03" reason="Never"/>
  <disable_collisions link1="link02" link2="link04" reason="Never"/>
  <disable_collisions link1="link03" link2="link05" reason="Never"/>
  <disable_collisions link1="link04" link2="link06" reason="Never"/>
  <disable_collisions link1="link05" link2="gripperStator" reason="Never"/>
  <disable_collisions link1="link06" link2="gripperMover" reason="Never"/>

  <!--
    link02 (shoulder motor) vs link06 (wrist motor):
    in the parking pose (all joints at 0, "zero" below) the wrist ends up right
    above the shoulder motor. The official URDF approximates both housings as
    full 65 mm cylinders, which interpenetrate by 8 mm there and therefore make
    the parking pose a *start state in collision* - MoveIt would refuse to plan
    from the documented zero pose. Real housings are not full cylinders, so the
    pair is disabled. Re-enable it if you replace the collision primitives with
    meshes.
  -->
  <disable_collisions link1="link02" link2="link06" reason="Never"/>

</robot>

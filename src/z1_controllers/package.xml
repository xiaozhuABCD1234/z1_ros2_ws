<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>z1_controllers</name>
  <version>0.1.0</version>
  <description>
    ros2_control controller for the Unitree Z1 arm that applies the official
    torque law (tau = Kp*e + Kd*edot, clamped to the joint effort limit) and
    exposes the same FollowJointTrajectory action as joint_trajectory_controller.
  </description>
  <maintainer email="xiaozhu@example.com">xiaozhu</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>controller_interface</depend>
  <depend>control_msgs</depend>
  <depend>hardware_interface</depend>
  <depend>lifecycle_msgs</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>realtime_tools</depend>
  <depend>trajectory_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
